# Copy this file to `.env` and adjust for your machine. `.env` is
# git-ignored — never commit real secrets. See app/config/settings.py for
# the full precedence chain (env vars > .env > config/*.local.yaml >
# config/*.yaml > field defaults).

# ---------- Application ----------
SENTINEL_APP_NAME="Sentinel Core Server"
SENTINEL_ENVIRONMENT=development
SENTINEL_DEBUG=true

# ---------- Server ----------
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000

# ---------- CORS ----------
# JSON array of allowed origins — must list every client that talks to
# this API (the web dashboard's dev server and/or static host at minimum).
SENTINEL_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# ---------- Database ----------
SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.db
SENTINEL_DATABASE_ECHO=false

# ---------- Logging ----------
SENTINEL_LOG_LEVEL=INFO
# "console" for human-readable local dev output, "json" for production
SENTINEL_LOG_FORMAT=console

# ---------- Secrets ----------
# REQUIRED in staging/production — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_SECRET_KEY=change-me-in-production

# ---------- Scheduler ----------
SENTINEL_SCHEDULER_ENABLED=true

# ---------- WebSocket ----------
SENTINEL_WEBSOCKET_HEARTBEAT_INTERVAL_SECONDS=30
